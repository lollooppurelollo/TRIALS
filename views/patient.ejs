<div class="bg-white border border-slate-200 p-8 rounded-2xl shadow-sm mb-8">
    <h1 class="text-2xl font-bold mb-1" style="color:#134e4a;">Ricerca Studi Clinici</h1>
    <p class="text-slate-500 mb-6 text-sm">Inserisci i criteri per trovare gli studi clinici disponibili.</p>

    <form id="searchForm" class="space-y-4">
        <div>
            <label for="clinicalArea" class="block text-sm font-medium text-slate-700">Area Clinica di interesse</label>
            <select id="clinicalArea" name="clinicalArea"
                    class="mt-1 p-2 w-full border border-slate-200 rounded-lg bg-white text-slate-900 focus:outline-none focus:ring-2 focus:ring-emerald-400" required>
                <option value="" disabled selected>Seleziona un'area</option>
                <option value="Mammella">Mammella</option>
                <option value="Polmone">Polmone</option>
                <option value="Gastro-Intestinale">Gastro-Intestinale</option>
                <option value="Ginecologico">Ginecologico</option>
                <option value="Prostata e Vie Urinarie">Prostata e Vie Urinarie</option>
                <option value="Melanoma e Cute">Melanoma e Cute</option>
                <option value="Testa-Collo">Testa-Collo</option>
                <option value="Fase 1">Fase 1</option>
                <option value="Altro">Altro</option>
            </select>
        </div>
        <div id="specificClinicalAreaContainer" class="hidden">
            <label for="specificClinicalAreas" class="block text-sm font-medium text-slate-700">Specifica Area Clinica di interesse</label>
            <select id="specificClinicalAreas" name="specificClinicalAreas"
                    class="mt-1 p-2 w-full border border-slate-200 rounded-lg bg-white text-slate-900 focus:outline-none focus:ring-2 focus:ring-emerald-400">
                <option value="" disabled selected>Seleziona un'area specifica (opzionale)</option>
            </select>
        </div>
        <div>
            <label for="treatmentSetting" class="block text-sm font-medium text-slate-700">Setting del Trattamento</label>
            <select id="treatmentSetting" name="treatmentSetting"
                    class="mt-1 p-2 w-full border border-slate-200 rounded-lg bg-white text-slate-900 focus:outline-none focus:ring-2 focus:ring-emerald-400" required>
                <option value="" disabled selected>Seleziona un setting</option>
                <option value="Metastatico">Metastatico</option>
                <option value="Adiuvante">Adiuvante</option>
                <option value="Neo-adiuvante">Neo-adiuvante</option>
            </select>
        </div>
        <div id="treatmentLineContainer" class="hidden">
            <label for="patientTreatmentLine" class="block text-sm font-medium text-slate-700">Linea di trattamento del paziente</label>
            <input type="number" id="patientTreatmentLine" name="patientTreatmentLine"
                   class="mt-1 p-2 w-full border border-slate-200 rounded-lg bg-white text-slate-900 focus:outline-none focus:ring-2 focus:ring-emerald-400"
                   placeholder="Esempio: 2">
        </div>

        <button type="submit"
                class="w-full text-white font-semibold p-3 rounded-lg transition-colors shadow-sm"
                style="background-color:#10b981;"
                onmouseover="this.style.backgroundColor='#059669'"
                onmouseout="this.style.backgroundColor='#10b981'">
            Cerca
        </button>
    </form>
</div>

<div id="searchResults" class="mt-8">
    <h2 class="text-xl font-bold mb-4" style="color:#134e4a;">Studi compatibili</h2>
    <div id="trialList" class="space-y-4">
        <!-- I risultati verranno iniettati qui -->
    </div>
</div>

<!-- Sezione ClinicalTrials.gov -->
<div id="ctgovSection" class="hidden mt-6">
    <!-- Header e opzioni -->
    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm p-6">
        <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
            <div class="flex items-center gap-3">
                <div class="p-2.5 rounded-xl flex-shrink-0" style="background-color:#1a3a5c;">
                    <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
                    </svg>
                </div>
                <div>
                    <h2 class="text-lg font-bold text-slate-800">Cerca su ClinicalTrials.gov</h2>
                    <p class="text-xs text-slate-500 mt-0.5">Studi internazionali basati sul profilo paziente</p>
                </div>
            </div>
            <!-- Filtri -->
            <div class="flex flex-wrap gap-4 text-sm">
                <!-- Paese -->
                <div class="flex flex-col gap-1">
                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Paese</span>
                    <div class="flex rounded-lg border border-slate-200 overflow-hidden">
                        <label class="ctgov-filter-pill active" data-group="country" data-val="Italy">
                            <input type="radio" name="ctgov_country" value="Italy" class="sr-only" checked>
                            🇮🇹 Solo Italia
                        </label>
                        <label class="ctgov-filter-pill" data-group="country" data-val="all">
                            <input type="radio" name="ctgov_country" value="all" class="sr-only">
                            🌍 Tutti
                        </label>
                    </div>
                </div>
                <!-- Status -->
                <div class="flex flex-col gap-1">
                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Stato</span>
                    <div class="flex rounded-lg border border-slate-200 overflow-hidden">
                        <label class="ctgov-filter-pill active" data-group="status" data-val="RECRUITING">
                            <input type="radio" name="ctgov_status" value="RECRUITING" class="sr-only" checked>
                            🟢 Recruiting
                        </label>
                        <label class="ctgov-filter-pill" data-group="status" data-val="all">
                            <input type="radio" name="ctgov_status" value="all" class="sr-only">
                            📋 Tutti
                        </label>
                    </div>
                </div>
                <!-- Tipo Studio -->
                <div class="flex flex-col gap-1">
                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Tipo Studio</span>
                    <div class="flex rounded-lg border border-slate-200 overflow-hidden">
                        <label class="ctgov-filter-pill active" data-group="studytype" data-val="INTERVENTIONAL">
                            <input type="radio" name="ctgov_studytype" value="INTERVENTIONAL" class="sr-only" checked>
                            💉 Interventistici
                        </label>
                        <label class="ctgov-filter-pill" data-group="studytype" data-val="all">
                            <input type="radio" name="ctgov_studytype" value="all" class="sr-only">
                            📋 Tutti
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <!-- Parametri inclusi nella ricerca (AND) -->
        <div class="mt-5 pt-4 border-t border-slate-100">
            <span class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-2">Parametri inclusi nella ricerca (collegati con AND)</span>
            <div class="flex flex-wrap gap-2 text-xs">
                <label class="ctgov-checkbox-pill active" id="ctgovLabelArea">
                    <input type="checkbox" id="ctgovIncArea" class="sr-only" checked>
                    🏢 Area Clinica: <span id="ctgovValArea" class="font-bold ml-1">—</span>
                </label>
                <label class="ctgov-checkbox-pill active" id="ctgovLabelSetting">
                    <input type="checkbox" id="ctgovIncSetting" class="sr-only" checked>
                    ⚙️ Setting: <span id="ctgovValSetting" class="font-bold ml-1">—</span>
                </label>
                <label class="ctgov-checkbox-pill active" id="ctgovLabelSpecific">
                    <input type="checkbox" id="ctgovIncSpecific" class="sr-only" checked>
                    🧬 Sottotipo: <span id="ctgovValSpecific" class="font-bold ml-1">—</span>
                </label>
            </div>
        </div>

        <!-- Pulsante ricerca -->
        <button id="ctgovSearchBtn"
                class="mt-5 w-full flex items-center justify-center gap-2 text-white font-semibold py-3 px-4 rounded-xl transition-all duration-200 shadow-sm"
                style="background-color:#1a3a5c;"
                onmouseover="this.style.backgroundColor='#0f2440'"
                onmouseout="this.style.backgroundColor='#1a3a5c'">
            <i class="fas fa-search text-sm"></i>
            Cerca su ClinicalTrials.gov
        </button>
    </div>
    <!-- Area risultati CT.gov -->
    <div id="ctgovResults" class="mt-4 space-y-4"></div>
    
    <!-- Pulsante Carica Altri Risultati -->
    <div id="ctgovLoadMoreContainer" class="hidden mt-4 text-center">
        <button id="ctgovLoadMoreBtn" 
                class="px-6 py-2.5 rounded-xl font-bold text-xs border border-slate-300 bg-white text-slate-700 hover:bg-slate-50 transition-colors shadow-sm inline-flex items-center gap-2">
            Carica altri studi <i class="fas fa-plus"></i>
        </button>
    </div>

    <!-- Sezione Altri Registri Esterni -->
    <div class="mt-8 bg-white border border-slate-200 rounded-2xl shadow-sm p-6">
        <h3 class="text-sm font-bold text-slate-800 mb-1">Altri Registri Clinici</h3>
        <p class="text-xs text-slate-500 mb-4">Effettua la ricerca direttamente sui portali istituzionali europei e italiani</p>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- EU Clinical Trials Register -->
            <a id="euctrSearchLink" href="https://www.clinicaltrialsregister.eu/" target="_blank" rel="noopener noreferrer"
               class="p-4 rounded-xl border border-slate-200 hover:border-slate-300 bg-slate-50/50 hover:bg-slate-50 transition-all flex items-start gap-3 group">
                <div class="p-2.5 rounded-lg bg-blue-50 text-blue-600 group-hover:bg-blue-100 transition-colors flex-shrink-0">
                    <i class="fas fa-globe-europe text-lg"></i>
                </div>
                <div>
                    <span class="block text-xs font-bold text-slate-800">EU Clinical Trials Register (EU CTR)</span>
                    <span class="block text-[10px] text-slate-400 mt-0.5">Apri ricerca pre-compilata per l'Europa/Italia</span>
                    <span class="inline-flex items-center text-[11px] font-semibold text-blue-600 mt-2 group-hover:text-blue-800">
                        Cerca su EU CTR <i class="fas fa-external-link-alt ml-1"></i>
                    </span>
                </div>
            </a>

            <!-- AIOM Portale Studi Clinici -->
            <a href="https://studiclinici.aiom.it/" target="_blank" rel="noopener noreferrer"
               class="p-4 rounded-xl border border-slate-200 hover:border-slate-300 bg-slate-50/50 hover:bg-slate-50 transition-all flex items-start gap-3 group">
                <div class="p-2.5 rounded-lg bg-emerald-50 text-emerald-600 group-hover:bg-emerald-100 transition-colors flex-shrink-0">
                    <i class="fas fa-user-md text-lg"></i>
                </div>
                <div>
                    <span class="block text-xs font-bold text-slate-800">AIOM Studi Clinici Italia</span>
                    <span class="block text-[10px] text-slate-400 mt-0.5">Portale oncologico dell'Assoc. Italiana Oncologia Medica</span>
                    <span class="inline-flex items-center text-[11px] font-semibold text-emerald-600 mt-2 group-hover:text-emerald-800">
                        Apri portale AIOM <i class="fas fa-external-link-alt ml-1"></i>
                    </span>
                </div>
            </a>
        </div>
    </div>
</div>

<!-- Modal Dettagli Studio -->
<div id="studyDetailModal"
     class="fixed inset-0 z-50 hidden flex items-start justify-center"
     style="padding: 4px 4px 76px 4px; background-color: rgba(15,23,42,0.45);">
    <div class="relative bg-white rounded-2xl shadow-2xl flex flex-col overflow-hidden border border-slate-200"
         style="width: min(1600px, 100%); height: calc(100vh - 80px);">
        <div class="modal-content flex-grow overflow-y-auto p-6 space-y-6">
            <div class="border-b border-slate-100 pb-4 text-center">
                <h3 class="text-xl font-bold text-slate-900" id="modalTitle"></h3>
                <p class="text-sm text-slate-500 mt-1" id="modalSubtitle"></p>
            </div>

            <!-- Informazioni Cliniche in griglia -->
            <div>
                <h4 class="font-semibold text-slate-400 mb-3 text-xs uppercase tracking-wider">Informazioni Cliniche</h4>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                  
                  <!-- Card Codice -->
                  <div class="p-4 rounded-xl border border-slate-200 bg-slate-50/30 flex items-start gap-3">
                    <div class="p-2 rounded-lg bg-emerald-50 text-emerald-600">
                      <i class="fas fa-barcode text-base"></i>
                    </div>
                    <div>
                      <span class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider">Codice Studio</span>
                      <span id="modalStudyCode" class="text-sm font-mono font-bold text-emerald-800">—</span>
                    </div>
                  </div>

                  <!-- Card Area Clinica -->
                  <div class="p-4 rounded-xl border border-slate-200 bg-slate-50/30 flex items-start gap-3">
                    <div class="p-2 rounded-lg bg-emerald-50 text-emerald-600">
                      <i class="fas fa-stethoscope text-base"></i>
                    </div>
                    <div>
                      <span class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider">Area Clinica</span>
                      <span id="modalClinicalAreas" class="text-sm font-semibold text-slate-800">—</span>
                      <span id="modalSpecificClinicalAreas" class="block text-xs text-slate-500 mt-0.5"></span>
                    </div>
                  </div>

                  <!-- Card Setting -->
                  <div class="p-4 rounded-xl border border-slate-200 bg-slate-50/30 flex items-start gap-3">
                    <div class="p-2 rounded-lg bg-emerald-50 text-emerald-600">
                      <i class="fas fa-sliders-h text-base"></i>
                    </div>
                    <div>
                      <span class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider">Setting & Linea</span>
                      <span id="modalTreatmentSetting" class="text-sm font-semibold text-slate-800">—</span>
                      <div id="modalTreatmentLineContainer" class="text-xs text-slate-500 mt-0.5 hidden">
                        Linea: <span id="modalTreatmentLine" class="font-semibold text-slate-700"></span>
                      </div>
                    </div>
                  </div>

                </div>
            </div>

            <!-- Contatti Referenti / PI (se presenti, utili anche per i pazienti per richiedere informazioni) -->
            <div id="modalPiContactsContainer" class="p-4 rounded-xl border border-slate-200 bg-emerald-50/15 flex items-start gap-3 hidden">
              <div class="p-2 rounded-lg bg-emerald-100 text-emerald-800">
                <i class="fas fa-user-md text-base"></i>
              </div>
              <div class="flex-grow">
                <span class="block text-[10px] font-bold text-emerald-900 uppercase tracking-wider">Contatti per lo Studio</span>
                <p id="modalPiContacts" class="text-sm text-slate-700 mt-1.5 whitespace-pre-wrap leading-relaxed"></p>
              </div>
            </div>

            <!-- Documenti allegati (solo visualizzazione) -->
            <div id="modalDocsSection">
              <h4 class="font-semibold text-slate-400 mb-3 text-xs uppercase tracking-wider">Documenti</h4>
              <div class="grid grid-cols-1 md:grid-cols-3 gap-3" id="modalDocsGrid">

                <!-- Protocollo PDF -->
                <div class="p-4 rounded-xl border border-slate-200 bg-slate-50/30">
                  <div class="flex items-center gap-2 mb-3">
                    <div class="p-2 rounded-lg bg-red-50 text-red-600"><i class="fas fa-file-pdf text-base"></i></div>
                    <span class="text-[11px] font-bold text-slate-500 uppercase tracking-wider">Protocollo PDF</span>
                  </div>
                  <div id="modalProtocolStatus" class="text-xs text-slate-400 mb-2 italic">Nessun file</div>
                  <div class="flex gap-2 flex-wrap">
                    <button id="modalDownloadProtocol" class="hidden text-xs px-3 py-1.5 rounded-lg bg-emerald-600 text-white font-semibold hover:bg-emerald-700 transition-colors">
                      <i class="fas fa-download mr-1"></i>Scarica
                    </button>
                  </div>
                </div>

                <!-- Study Schema -->
                <div class="p-4 rounded-xl border border-slate-200 bg-slate-50/30">
                  <div class="flex items-center gap-2 mb-3">
                    <div class="p-2 rounded-lg bg-blue-50 text-blue-600"><i class="fas fa-project-diagram text-base"></i></div>
                    <span class="text-[11px] font-bold text-slate-500 uppercase tracking-wider">Study Schema</span>
                  </div>
                  <div id="modalSchemaStatus" class="text-xs text-slate-400 mb-2 italic">Nessun file</div>
                  <div class="flex gap-2 flex-wrap">
                    <button id="modalViewSchema" class="hidden text-xs px-3 py-1.5 rounded-lg bg-blue-600 text-white font-semibold hover:bg-blue-700 transition-colors">
                      <i class="fas fa-eye mr-1"></i>Visualizza
                    </button>
                    <button id="modalDownloadSchema" class="hidden text-xs px-3 py-1.5 rounded-lg bg-emerald-600 text-white font-semibold hover:bg-emerald-700 transition-colors">
                      <i class="fas fa-download mr-1"></i>Scarica
                    </button>
                  </div>
                </div>

                <!-- Allegati extra -->
                <div class="p-4 rounded-xl border border-slate-200 bg-slate-50/30">
                  <div class="flex items-center gap-2 mb-3">
                    <div class="p-2 rounded-lg bg-violet-50 text-violet-600"><i class="fas fa-paperclip text-base"></i></div>
                    <span class="text-[11px] font-bold text-slate-500 uppercase tracking-wider">Allegati</span>
                  </div>
                  <div id="modalExtraFilesList" class="space-y-1.5"></div>
                </div>

              </div>
            </div>

            <!-- Criteri di I/E -->
            <div>
                <h4 class="font-semibold text-slate-400 mb-3 text-xs uppercase tracking-wider">Criteri di Inclusione / Esclusione</h4>
                <div id="criteriaContainer"></div>
            </div>

        </div>
        <div class="px-5 py-4 bg-white border-t border-slate-200 space-y-2">
            <button id="checkEligibilityBtn"
                    class="w-full text-white text-base font-semibold rounded-lg px-4 py-2 shadow-sm transition-colors"
                    style="background-color:#10b981;"
                    onmouseover="this.style.backgroundColor='#059669'"
                    onmouseout="this.style.backgroundColor='#10b981'">
                Controlla eleggibilità
            </button>
            <button id="openTimelineBtn"
                    class="w-full text-white text-base font-semibold rounded-lg px-4 py-2 shadow-sm flex items-center justify-center gap-2 transition-colors"
                    style="background-color:#10b981;"
                    onmouseover="this.style.backgroundColor='#059669'"
                    onmouseout="this.style.backgroundColor='#10b981'">
                <i class="fas fa-calendar-alt"></i>
                Timeline
            </button>
            <div id="eligibilityResultDiv" class="font-bold text-center mb-3 hidden"></div>
            <button id="closeModalBtn"
                    class="w-full bg-slate-100 text-slate-700 text-base font-semibold rounded-lg px-4 py-2 shadow-sm hover:bg-slate-200 transition-colors">
                Chiudi
            </button>
        </div>
    </div>
</div>

<!-- Study Schema Viewer Modal (Paziente) -->
<div id="schemaViewerModal" class="fixed inset-0 z-[60] hidden items-center justify-center" style="background-color:rgba(15,23,42,0.7);">
  <div class="relative bg-white rounded-2xl shadow-2xl flex flex-col" style="width:min(95vw,1100px);height:90vh;">
    <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100 flex-shrink-0">
      <h3 class="font-bold text-slate-800">Study Schema</h3>
      <div class="flex gap-2">
        <button id="schemaViewerDownload" class="text-xs px-3 py-1.5 rounded-lg bg-emerald-600 text-white font-semibold hover:bg-emerald-700 transition-colors">
          <i class="fas fa-download mr-1"></i>Scarica
        </button>
        <button id="schemaViewerClose" class="text-xs px-3 py-1.5 rounded-lg bg-slate-100 text-slate-700 font-semibold hover:bg-slate-200 transition-colors">
          <i class="fas fa-times mr-1"></i>Chiudi
        </button>
      </div>
    </div>
    <div class="flex-grow overflow-auto flex items-center justify-center bg-slate-100 rounded-b-2xl p-4">
      <iframe id="schemaViewerIframe" class="w-full h-full rounded-lg hidden" style="border:none;"></iframe>
      <img id="schemaViewerImg" class="max-w-full max-h-full object-contain rounded-lg hidden" alt="Study Schema">
    </div>
  </div>
</div>
