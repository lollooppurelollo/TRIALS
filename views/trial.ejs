<!-- ── Gestione Studi Clinici ─────────────────────────────── -->
<div class="bg-white border border-slate-200 p-8 rounded-2xl shadow-sm mb-8">
  <h1 class="text-2xl font-bold mb-1" style="color:#134e4a;">Gestione Studi Clinici</h1>
  <p class="text-slate-500 mb-6 text-sm">Aggiungi o visualizza gli studi clinici disponibili.</p>

  <form id="studyForm" class="space-y-4">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

      <!-- TITOLO STUDIO -->
      <div>
        <label for="studyTitle" class="block text-sm font-medium text-slate-700">Titolo dello studio</label>
        <textarea id="studyTitle" rows="3"
                  class="mt-1 p-2 w-full border border-slate-200 rounded-lg bg-white text-slate-900 focus:outline-none"
                  required></textarea>
      </div>

      <!-- SOTTOTITOLO -->
      <div>
        <label for="studySubtitle" class="block text-sm font-medium text-slate-700">Sottotitolo/descrizione breve</label>
        <textarea id="studySubtitle" rows="3"
                  class="mt-1 p-2 w-full border border-slate-200 rounded-lg bg-white text-slate-900 focus:outline-none"></textarea>
      </div>

      <!-- CODICE STUDIO (auto-generato, modificabile) -->
      <div class="md:col-span-2">
        <label for="studyCode" class="block text-sm font-medium text-slate-700">
          Codice Studio <span class="text-xs text-slate-400 font-normal">(auto-generato, modificabile)</span>
        </label>
        <input type="text" id="studyCode"
               placeholder="Seleziona un'area clinica per generare il codice..."
               class="mt-1 p-2 w-full border border-slate-200 rounded-lg bg-slate-50 text-slate-900 font-mono tracking-wide focus:outline-none">
        <p id="codeError" class="text-xs text-red-500 mt-1 hidden">Attenzione: Questo Codice Studio è già presente nel sistema!</p>
      </div>

      <!-- AREA CLINICA -->
      <div>
        <label for="studyClinicalAreas" class="block text-sm font-medium text-slate-700">Area Clinica di interesse</label>
        <select id="studyClinicalAreas" multiple
                class="mt-1 p-2 w-full border border-slate-200 rounded-lg bg-white text-slate-900 focus:outline-none"
                required>
          <option value="Mammella">Mammella</option>
          <option value="Polmone">Polmone</option>
          <option value="Gastro-Intestinale">Gastro-Intestinale</option>
          <option value="Ginecologico">Ginecologico</option>
          <option value="Prostata e Vie Urinarie">Prostata e Vie Urinarie</option>
          <option value="Melanoma e Cute">Melanoma e Cute</option>
          <option value="Testa-Collo">Testa-Collo</option>
          <option value="Fase 1">Fase 1</option>
          <option value="Altro">Altro</option>
        </select>
      </div>

      <!-- SPECIFICA AREA CLINICA -->
      <div id="studySpecificClinicalAreaContainer" class="hidden">
        <label for="studySpecificClinicalAreas" class="block text-sm font-medium text-slate-700">Specifica Area Clinica di interesse</label>
        <select id="studySpecificClinicalAreas" multiple
                class="mt-1 p-2 w-full border border-slate-200 rounded-lg bg-white text-slate-900 focus:outline-none"></select>
      </div>

      <!-- SETTING DEL TRATTAMENTO -->
      <div>
        <label for="studyTreatmentSetting" class="block text-sm font-medium text-slate-700">Setting del Trattamento</label>
        <select id="studyTreatmentSetting"
                class="mt-1 p-2 w-full border border-slate-200 rounded-lg bg-white text-slate-900 focus:outline-none"
                required>
          <option value="" disabled selected>Seleziona un setting</option>
          <option value="Metastatico">Metastatico</option>
          <option value="Adiuvante">Adiuvante</option>
          <option value="Neo-adiuvante">Neo-adiuvante</option>
        </select>
      </div>

      <!-- LINEA DI TRATTAMENTO -->
      <div id="studyTreatmentLineContainer" class="hidden">
        <label class="block text-sm font-medium text-slate-700">Linea di Trattamento (min-max)</label>
        <div class="flex space-x-2 mt-1">
          <input type="number" id="minTreatmentLine"
                 class="p-2 w-1/2 border border-slate-200 rounded-lg bg-white text-slate-900 focus:outline-none"
                 placeholder="Min">
          <input type="number" id="maxTreatmentLine"
                 class="p-2 w-1/2 border border-slate-200 rounded-lg bg-white text-slate-900 focus:outline-none"
                 placeholder="Max">
        </div>
      </div>

    </div>

    <!-- NUMERO BRACCI -->
    <div>
      <label for="studyArmsCount" class="block text-sm font-medium text-slate-700">Numero Bracci</label>
      <select id="studyArmsCount"
              class="mt-1 p-2 w-full border border-slate-200 rounded-lg bg-white text-slate-900 focus:outline-none">
        <option value="1" selected>1 (Studio a braccio singolo)</option>
        <option value="2">2</option>
        <option value="3">3</option>
        <option value="4">4</option>
      </select>
    </div>

    <!-- CONFIGURAZIONE BRACCI -->
    <div id="studyArmsContainer" class="hidden">
      <label class="block text-sm font-medium text-slate-700 mb-2">Configurazione Bracci</label>
      <div id="armsList" class="space-y-2"></div>
    </div>

    <!-- INFORMAZIONI INTERNE DEL CENTRO -->
    <div class="border-t border-slate-100 pt-5 mt-2">
      <h3 class="text-base font-semibold text-slate-800 mb-3">Informazioni Interne del Centro</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label for="studyInternalNotes" class="block text-sm font-medium text-slate-700">Note Personalizzate</label>
          <textarea id="studyInternalNotes" rows="3"
                    class="mt-1 p-2 w-full border border-slate-200 rounded-lg bg-white text-slate-900 focus:outline-none"
                    placeholder="Annotazioni e specifiche interne al centro..."></textarea>
        </div>
        <div>
          <label for="studyPiContacts" class="block text-sm font-medium text-slate-700">Contatti dei Referenti / PI</label>
          <textarea id="studyPiContacts" rows="3"
                    class="mt-1 p-2 w-full border border-slate-200 rounded-lg bg-white text-slate-900 focus:outline-none"
                    placeholder="Nome, email e recapiti del Principal Investigator..."></textarea>
        </div>
        <div>
          <label for="studyStatus" class="block text-sm font-medium text-slate-700">Stato dello Studio</label>
          <select id="studyStatus"
                  class="mt-1 p-2 w-full border border-slate-200 rounded-lg bg-white text-slate-900 focus:outline-none">
            <option value="" selected>— Non Specificato —</option>
            <option value="in_attivazione">🟡 In Attivazione</option>
            <option value="attivo">🟢 Attivo</option>
          </select>
        </div>
      </div>
    </div>

    <!-- DOCUMENTI E ALLEGATI -->
    <div class="border-t border-slate-100 pt-5 mt-2">
      <h3 class="text-base font-semibold text-slate-800 mb-3">Documenti e Allegati dello Studio</h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <!-- Protocollo PDF -->
        <div>
          <label for="studyFormProtocol" class="block text-sm font-medium text-slate-700 text-xs">Protocollo PDF</label>
          <input type="file" id="studyFormProtocol" accept="application/pdf"
                 class="mt-1 p-1 w-full border border-slate-200 rounded-lg bg-white text-slate-900 text-xs focus:outline-none file:mr-2 file:py-1 file:px-2.5 file:rounded-lg file:border-0 file:text-[11px] file:font-semibold file:bg-emerald-50 file:text-emerald-700 hover:file:bg-emerald-100">
        </div>
        <!-- Study Schema -->
        <div>
          <label for="studyFormSchema" class="block text-sm font-medium text-slate-700 text-xs">Study Schema (PDF o Immagine)</label>
          <input type="file" id="studyFormSchema" accept="application/pdf,image/*"
                 class="mt-1 p-1 w-full border border-slate-200 rounded-lg bg-white text-slate-900 text-xs focus:outline-none file:mr-2 file:py-1 file:px-2.5 file:rounded-lg file:border-0 file:text-[11px] file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100">
        </div>
        <!-- Allegati extra -->
        <div>
          <label for="studyFormExtras" class="block text-sm font-medium text-slate-700 text-xs">Allegati extra (max 4, PDF o Immagini)</label>
          <input type="file" id="studyFormExtras" accept="application/pdf,image/*" multiple
                 class="mt-1 p-1 w-full border border-slate-200 rounded-lg bg-white text-slate-900 text-xs focus:outline-none file:mr-2 file:py-1 file:px-2.5 file:rounded-lg file:border-0 file:text-[11px] file:font-semibold file:bg-violet-50 file:text-violet-700 hover:file:bg-violet-100">
        </div>
      </div>
    </div>

    <!-- CRITERI INCLUSIONE/ESCLUSIONE -->
    <div class="border-t border-slate-100 pt-5 mt-2">
      <h3 class="text-base font-semibold text-slate-800 mb-3">Criteri di Inclusione/Esclusione</h3>
      <div id="criteriaList" class="space-y-2 mb-4"></div>
      <button type="button" id="addCriteriaBtn"
              class="bg-slate-100 text-slate-700 px-4 py-2 rounded-lg hover:bg-slate-200 transition-colors text-sm font-medium">
        + Aggiungi Criterio
      </button>
    </div>

    <button type="submit"
            class="w-full text-white font-semibold p-3 rounded-lg transition-colors shadow-sm mt-4"
            style="background-color:#10b981;"
            onmouseover="this.style.backgroundColor='#059669'"
            onmouseout="this.style.backgroundColor='#10b981'">
      Salva Studio
    </button>
  </form>
</div>

<!-- ── Import Studio (JSON) Comprimibile ─────────────────── -->
<details class="group bg-white border border-slate-200 rounded-2xl shadow-sm mb-8 mt-12 overflow-hidden">
  <summary class="flex items-center justify-between p-5 font-semibold cursor-pointer hover:bg-slate-50 transition-colors select-none">
    <div class="flex items-center gap-2.5" style="color:#134e4a;">
      <i class="fas fa-file-import text-emerald-600"></i>
      <span class="text-base font-bold">Importa studio da JSON</span>
    </div>
    <span class="transition-transform duration-200 group-open:rotate-180">
      <i class="fas fa-chevron-down text-sm text-slate-400"></i>
    </span>
  </summary>
  <div class="px-6 pb-6 pt-3 border-t border-slate-100 space-y-4">
    <div class="flex items-center justify-between gap-4">
      <p class="text-slate-500 text-xs">
        Incolla il JSON generato dall’analisi del protocollo. Verranno precompilati i campi del form sopra.
      </p>
      <button id="studyImportClearBtn" type="button"
              class="text-xs px-2.5 py-1.5 rounded-lg bg-white border border-slate-200 text-slate-600 hover:bg-slate-50 transition-colors flex-shrink-0">
        Pulisci
      </button>
    </div>

    <textarea id="studyImportTextarea" rows="4"
              class="w-full p-3 border border-slate-200 rounded-lg font-mono text-xs text-slate-800 bg-slate-50 focus:outline-none"
              placeholder='{"study":{"title":"...","subtitle":"...","clinical_areas":["Polmone"],"specific_clinical_areas":["NSCLC"],"treatment_setting":"Metastatico","min_treatment_line":1,"max_treatment_line":1,"criteria":[{"type":"inclusion","text":"..."},{"type":"exclusion","text":"..."}]}}'></textarea>

    <div id="studyImportMsg" class="mt-1 text-xs hidden"></div>

    <button id="studyImportBtn" type="button"
            class="w-full text-white font-semibold py-2 px-4 rounded-lg transition-colors shadow-sm text-sm"
            style="background-color:#10b981;"
            onmouseover="this.style.backgroundColor='#059669'"
            onmouseout="this.style.backgroundColor='#10b981'">
      Precompila il form
    </button>
  </div>
</details>

<!-- ── Studi Attivi ──────────────────────────────────────── -->
<div id="trialListSection" class="mt-8">
  <div class="flex items-center justify-between mb-4">
    <h2 class="text-xl font-bold" style="color:#134e4a; margin: 0;">Studi Attivi</h2>
    <button id="openMapBtn" type="button" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold rounded-lg transition-colors shadow-sm text-sm flex items-center gap-1.5">
      <i class="fas fa-map"></i> Mappa
    </button>
  </div>
  <div class="bg-white border border-slate-200 p-6 rounded-2xl shadow-sm mb-8">
    <form id="trialFilterForm" class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div>
        <label for="filterClinicalArea" class="block text-sm font-medium text-slate-700">Area Clinica</label>
        <select id="filterClinicalArea"
                class="mt-1 p-2 w-full border border-slate-200 rounded-lg bg-white text-slate-900 focus:outline-none">
          <option value="">Tutte le Aree</option>
          <option value="Mammella">Mammella</option>
          <option value="Polmone">Polmone</option>
          <option value="Gastro-Intestinale">Gastro-Intestinale</option>
          <option value="Ginecologico">Ginecologico</option>
          <option value="Prostata e Vie Urinarie">Prostata e Vie Urinarie</option>
          <option value="Melanoma e Cute">Melanoma e Cute</option>
          <option value="Testa-Collo">Testa-Collo</option>
          <option value="Fase 1">Fase 1</option>
          <option value="Altro">Altro</option>
        </select>
      </div>
      <div id="filterSpecificClinicalAreaContainer" class="hidden">
        <label for="filterSpecificClinicalAreas" class="block text-sm font-medium text-slate-700">Specifica Area</label>
        <select id="filterSpecificClinicalAreas"
                class="mt-1 p-2 w-full border border-slate-200 rounded-lg bg-white text-slate-900 focus:outline-none">
          <option value="">Tutte le Specifiche</option>
        </select>
      </div>
      <div>
        <label for="filterTreatmentSetting" class="block text-sm font-medium text-slate-700">Setting</label>
        <select id="filterTreatmentSetting"
                class="mt-1 p-2 w-full border border-slate-200 rounded-lg bg-white text-slate-900 focus:outline-none">
          <option value="">Tutti i Setting</option>
          <option value="Metastatico">Metastatico</option>
          <option value="Adiuvante">Adiuvante</option>
          <option value="Neo-adiuvante">Neo-adiuvante</option>
        </select>
      </div>
    </form>
  </div>
  <div id="trialList" class="space-y-4 mt-4"></div>
</div>

<!-- ── Modal Dettagli Studio ─────────────────────────────── -->
<div id="studyDetailModal"
     class="fixed inset-0 z-50 flex items-start justify-center hidden"
     style="padding: 4px 4px 76px 4px; background-color: rgba(15,23,42,0.45);">
  <div class="relative bg-white rounded-2xl shadow-2xl flex flex-col border border-slate-200"
       style="width: min(1600px, 100%); height: calc(100vh - 80px);">
    <div class="p-6 flex-shrink-0 border-b border-slate-100">
      <h3 class="text-lg leading-6 font-bold text-slate-900" id="modalTitle"></h3>
      <p class="text-sm text-slate-500 mt-1" id="modalSubtitle"></p>
    </div>
    <div class="modal-content flex-grow overflow-y-auto px-6 py-4 space-y-6">
      
      <!-- Informazioni Cliniche in griglia -->
      <div>
        <h4 class="font-semibold text-slate-400 mb-3 text-xs uppercase tracking-wider">Informazioni Cliniche</h4>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          
          <!-- Card Codice -->
          <div class="p-4 rounded-xl border border-slate-200 bg-slate-50/30 flex items-start gap-3">
            <div class="p-2 rounded-lg bg-emerald-50 text-emerald-600">
              <i class="fas fa-barcode text-base"></i>
            </div>
            <div>
              <span class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider">Codice Studio</span>
              <span id="modalStudyCode" class="text-sm font-mono font-bold text-emerald-800">—</span>
            </div>
          </div>

          <!-- Card Area Clinica -->
          <div class="p-4 rounded-xl border border-slate-200 bg-slate-50/30 flex items-start gap-3">
            <div class="p-2 rounded-lg bg-emerald-50 text-emerald-600">
              <i class="fas fa-stethoscope text-base"></i>
            </div>
            <div>
              <span class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider">Area Clinica</span>
              <span id="modalClinicalAreas" class="text-sm font-semibold text-slate-800">—</span>
              <span id="modalSpecificClinicalAreas" class="block text-xs text-slate-500 mt-0.5"></span>
            </div>
          </div>

          <!-- Card Setting -->
          <div class="p-4 rounded-xl border border-slate-200 bg-slate-50/30 flex items-start gap-3">
            <div class="p-2 rounded-lg bg-emerald-50 text-emerald-600">
              <i class="fas fa-sliders-h text-base"></i>
            </div>
            <div>
              <span class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider">Setting & Linea</span>
              <span id="modalTreatmentSetting" class="text-sm font-semibold text-slate-800">—</span>
              <div id="modalTreatmentLineContainer" class="text-xs text-slate-500 mt-0.5 hidden">
                Linea: <span id="modalTreatmentLine" class="font-semibold text-slate-700"></span>
              </div>
            </div>
          </div>

          <!-- Card Stato Studio -->
          <div id="modalStudyStatusCard" class="p-4 rounded-xl border flex items-start gap-3">
            <div class="p-2 rounded-lg" id="modalStudyStatusIcon">
              <i class="fas fa-circle-dot text-base"></i>
            </div>
            <div>
              <span class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider">Stato Studio</span>
              <span id="modalStudyStatus" class="text-sm font-semibold">—</span>
            </div>
          </div>

        </div>
      </div>

      <!-- Informazioni Interne del Centro (Note + Contatti) -->
      <div id="modalCenterInfoSection" class="grid grid-cols-1 md:grid-cols-2 gap-4">
        
        <!-- Card Note Personalizzate -->
        <div id="modalInternalNotesContainer" class="p-4 rounded-xl border border-slate-200 bg-amber-50/20 flex items-start gap-3 hidden">
          <div class="p-2 rounded-lg bg-amber-100 text-amber-700">
            <i class="fas fa-sticky-note text-base"></i>
          </div>
          <div class="flex-grow">
            <span class="block text-[10px] font-bold text-amber-800 uppercase tracking-wider">Note Personalizzate</span>
            <p id="modalInternalNotes" class="text-sm text-slate-700 mt-1.5 whitespace-pre-wrap leading-relaxed"></p>
          </div>
        </div>

        <!-- Card Referenti / PI -->
        <div id="modalPiContactsContainer" class="p-4 rounded-xl border border-slate-200 bg-emerald-50/15 flex items-start gap-3 hidden">
          <div class="p-2 rounded-lg bg-emerald-100 text-emerald-800">
            <i class="fas fa-user-md text-base"></i>
          </div>
          <div class="flex-grow">
            <span class="block text-[10px] font-bold text-emerald-900 uppercase tracking-wider">Contatti Referenti / PI</span>
            <p id="modalPiContacts" class="text-sm text-slate-700 mt-1.5 whitespace-pre-wrap leading-relaxed"></p>
          </div>
        </div>

      </div>

      <!-- Documenti allegati -->
      <div id="modalDocsSection">
        <h4 class="font-semibold text-slate-400 mb-3 text-xs uppercase tracking-wider">Documenti</h4>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-3" id="modalDocsGrid">

          <!-- Protocollo PDF -->
          <div class="p-4 rounded-xl border border-slate-200 bg-slate-50/30">
            <div class="flex items-center gap-2 mb-3">
              <div class="p-2 rounded-lg bg-red-50 text-red-600"><i class="fas fa-file-pdf text-base"></i></div>
              <span class="text-[11px] font-bold text-slate-500 uppercase tracking-wider">Protocollo PDF</span>
            </div>
            <div id="modalProtocolStatus" class="text-xs text-slate-400 mb-2 italic">Nessun file</div>
            <div class="flex gap-2 flex-wrap">
              <button id="modalDownloadProtocol" class="hidden text-xs px-3 py-1.5 rounded-lg bg-emerald-600 text-white font-semibold hover:bg-emerald-700 transition-colors">
                <i class="fas fa-download mr-1"></i>Scarica
              </button>
              <label id="modalUploadProtocolLabel" class="hidden cursor-pointer text-xs px-3 py-1.5 rounded-lg border border-slate-300 text-slate-600 hover:bg-slate-100 transition-colors">
                <i class="fas fa-upload mr-1"></i>Sostituisci
                <input type="file" id="modalUploadProtocol" accept="application/pdf" class="hidden">
              </label>
              <label id="modalUploadProtocolFirstLabel" class="cursor-pointer text-xs px-3 py-1.5 rounded-lg bg-emerald-600 text-white font-semibold hover:bg-emerald-700 transition-colors">
                <i class="fas fa-upload mr-1"></i>Carica
                <input type="file" id="modalUploadProtocolFirst" accept="application/pdf" class="hidden">
              </label>
              <button id="modalDeleteProtocol" class="hidden text-xs px-3 py-1.5 rounded-lg border border-red-200 text-red-500 hover:bg-red-50 transition-colors">
                <i class="fas fa-trash mr-1"></i>Elimina
              </button>
            </div>
            <div id="modalProtocolUploadMsg" class="text-xs mt-1 hidden"></div>
          </div>

          <!-- Study Schema -->
          <div class="p-4 rounded-xl border border-slate-200 bg-slate-50/30">
            <div class="flex items-center gap-2 mb-3">
              <div class="p-2 rounded-lg bg-blue-50 text-blue-600"><i class="fas fa-project-diagram text-base"></i></div>
              <span class="text-[11px] font-bold text-slate-500 uppercase tracking-wider">Study Schema</span>
            </div>
            <div id="modalSchemaStatus" class="text-xs text-slate-400 mb-2 italic">Nessun file</div>
            <div class="flex gap-2 flex-wrap">
              <button id="modalViewSchema" class="hidden text-xs px-3 py-1.5 rounded-lg bg-blue-600 text-white font-semibold hover:bg-blue-700 transition-colors">
                <i class="fas fa-eye mr-1"></i>Visualizza
              </button>
              <button id="modalDownloadSchema" class="hidden text-xs px-3 py-1.5 rounded-lg bg-emerald-600 text-white font-semibold hover:bg-emerald-700 transition-colors">
                <i class="fas fa-download mr-1"></i>Scarica
              </button>
              <label id="modalUploadSchemaLabel" class="hidden cursor-pointer text-xs px-3 py-1.5 rounded-lg border border-slate-300 text-slate-600 hover:bg-slate-100 transition-colors">
                <i class="fas fa-upload mr-1"></i>Sostituisci
                <input type="file" id="modalUploadSchema" accept="application/pdf,image/*" class="hidden">
              </label>
              <label id="modalUploadSchemaFirstLabel" class="cursor-pointer text-xs px-3 py-1.5 rounded-lg bg-blue-600 text-white font-semibold hover:bg-blue-700 transition-colors">
                <i class="fas fa-upload mr-1"></i>Carica
                <input type="file" id="modalUploadSchemaFirst" accept="application/pdf,image/*" class="hidden">
              </label>
              <button id="modalDeleteSchema" class="hidden text-xs px-3 py-1.5 rounded-lg border border-red-200 text-red-500 hover:bg-red-50 transition-colors">
                <i class="fas fa-trash mr-1"></i>Elimina
              </button>
            </div>
            <div id="modalSchemaUploadMsg" class="text-xs mt-1 hidden"></div>
          </div>

          <!-- Allegati extra -->
          <div class="p-4 rounded-xl border border-slate-200 bg-slate-50/30">
            <div class="flex items-center gap-2 mb-3">
              <div class="p-2 rounded-lg bg-violet-50 text-violet-600"><i class="fas fa-paperclip text-base"></i></div>
              <span class="text-[11px] font-bold text-slate-500 uppercase tracking-wider">Allegati (max 4)</span>
            </div>
            <div id="modalExtraFilesList" class="space-y-1.5 mb-2"></div>
            <label id="modalUploadExtraLabel" class="cursor-pointer inline-flex items-center gap-1 text-xs px-3 py-1.5 rounded-lg bg-violet-600 text-white font-semibold hover:bg-violet-700 transition-colors">
              <i class="fas fa-plus mr-1"></i>Aggiungi file
              <input type="file" id="modalUploadExtra" accept="application/pdf,image/*" class="hidden">
            </label>
            <div id="modalExtraUploadMsg" class="text-xs mt-1 hidden"></div>
          </div>

        </div>
      </div>

      <!-- Criteri di I/E -->
      <div>
        <h4 class="font-semibold text-slate-400 mb-3 text-xs uppercase tracking-wider">Criteri di Inclusione / Esclusione</h4>
        <div id="criteriaContainer"></div>
      </div>

    </div>
    <div class="p-5 border-t border-slate-100 flex-shrink-0 space-y-2">
      <button id="openTimelineBtn"
              class="w-full text-white text-base font-semibold rounded-lg px-4 py-2 shadow-sm flex items-center justify-center gap-2 transition-colors"
              style="background-color:#10b981;"
              onmouseover="this.style.backgroundColor='#059669'"
              onmouseout="this.style.backgroundColor='#10b981'">
        <i class="fas fa-calendar-alt"></i> Timeline
      </button>
      <button id="closeModalBtn"
              class="px-4 py-2 bg-slate-100 text-slate-700 text-base font-semibold rounded-lg w-full hover:bg-slate-200 transition-colors">
        Chiudi
      </button>
    </div>
  </div>
</div>

<!-- Study Schema Viewer Modal -->
<div id="schemaViewerModal" class="fixed inset-0 z-[60] hidden items-center justify-center" style="background-color:rgba(15,23,42,0.7);">
  <div class="relative bg-white rounded-2xl shadow-2xl flex flex-col" style="width:min(95vw,1100px);height:90vh;">
    <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100 flex-shrink-0">
      <h3 class="font-bold text-slate-800">Study Schema</h3>
      <div class="flex gap-2">
        <button id="schemaViewerDownload" class="text-xs px-3 py-1.5 rounded-lg bg-emerald-600 text-white font-semibold hover:bg-emerald-700 transition-colors">
          <i class="fas fa-download mr-1"></i>Scarica
        </button>
        <button id="schemaViewerClose" class="text-xs px-3 py-1.5 rounded-lg bg-slate-100 text-slate-700 font-semibold hover:bg-slate-200 transition-colors">
          <i class="fas fa-times mr-1"></i>Chiudi
        </button>
      </div>
    </div>
    <div class="flex-grow overflow-auto flex items-center justify-center bg-slate-100 rounded-b-2xl p-4">
      <iframe id="schemaViewerIframe" class="w-full h-full rounded-lg hidden" style="border:none;"></iframe>
      <img id="schemaViewerImg" class="max-w-full max-h-full object-contain rounded-lg hidden" alt="Study Schema">
    </div>
  </div>
</div>

