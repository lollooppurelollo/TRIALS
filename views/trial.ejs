<!-- ── Modal Mappa degli Studi Clinici ─────────────────────── -->
<div id="studyMapModal"
     class="fixed inset-0 hidden"
     style="background-color: #ffffff; z-index: 9999; width: 100vw; height: 100vh; overflow: hidden;">
  <div class="relative bg-white flex flex-col w-full h-full">
    
    <!-- Modal Header -->
    <div class="p-6 flex-shrink-0 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
      <div>
        <h3 class="text-xl font-bold text-slate-900 flex items-center gap-2" style="color: #134e4a;">
          <i class="fas fa-map text-emerald-600"></i> Mappa Grafica degli Studi Clinici
        </h3>
        <p class="text-xs text-slate-500 mt-1">Visualizzazione grafica e mappa strutturata degli studi.</p>
      </div>
      <button id="closeMapModalBtn" class="text-slate-400 hover:text-slate-600 transition-colors p-2 rounded-full hover:bg-slate-100">
        <i class="fas fa-times text-lg"></i>
      </button>
    </div>

    <!-- Modal Content: Sidebar (filters) + Main Area (canvas) -->
    <div class="flex-grow flex overflow-hidden">
      <!-- Sidebar Filters (Left) -->
      <div class="w-80 border-r border-slate-100 p-6 flex flex-col gap-5 bg-slate-50/30 overflow-y-auto flex-shrink-0">
        <div>
          <label for="mapClinicalArea" class="block text-xs font-bold text-slate-400 uppercase tracking-wider">Area Clinica *</label>
          <select id="mapClinicalArea" class="mt-1.5 p-2.5 w-full border border-slate-200 rounded-xl bg-white text-slate-900 text-sm font-semibold">
            <option value="Mammella">Mammella</option>
            <option value="Polmone">Polmone</option>
            <option value="Gastro-Intestinale">Gastro-Intestinale</option>
            <option value="Ginecologico">Ginecologico</option>
            <option value="Prostata e Vie Urinarie">Prostata e Vie Urinarie</option>
            <option value="Melanoma e Cute">Melanoma e Cute</option>
            <option value="Testa-Collo">Testa-Collo</option>
            <option value="Fase 1">Fase 1</option>
            <option value="Altro">Altro</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Specifica Area (Multiselezione)</label>
          <div id="mapSpecificAreaPills" class="flex flex-col gap-2 max-h-[180px] overflow-y-auto p-1.5 border border-slate-200 rounded-xl bg-white">
            <!-- Pills generated dynamically in JS -->
          </div>
        </div>

        <div>
          <label for="mapSetting" class="block text-xs font-bold text-slate-400 uppercase tracking-wider">Setting (Opzionale)</label>
          <select id="mapSetting" class="mt-1.5 p-2.5 w-full border border-slate-200 rounded-xl bg-white text-slate-900 text-sm">
            <option value="">Tutti i setting</option>
            <option value="Metastatico">Metastatico</option>
            <option value="Adiuvante">Adiuvante</option>
            <option value="Neo-adiuvante">Neo-adiuvante</option>
          </select>
        </div>

        <div class="border-t border-slate-100 pt-4 flex flex-col gap-2.5">
          <span class="block text-xs font-bold text-slate-400 uppercase tracking-wider">Legenda Bordo (Stato)</span>
          <div class="flex flex-col gap-2 mt-1.5 bg-slate-50 p-3 rounded-xl border border-slate-100">
            <div class="flex items-center gap-2">
              <span style="width: 22px; height: 12px; border-radius: 3px; border: 2px solid #64748b; background: #ffffff; display: inline-block;"></span>
              <span class="text-xs text-slate-700 font-semibold">🟢 Studio Attivo (Continuo)</span>
            </div>
            <div class="flex items-center gap-2">
              <span style="width: 22px; height: 12px; border-radius: 3px; border: 2px dashed #94a3b8; background: #ffffff; display: inline-block;"></span>
              <span class="text-xs text-slate-700 font-semibold">🟡 In Attivazione (Tratteggiato)</span>
            </div>
          </div>
        </div>

        <div class="border-t border-slate-100 pt-4 flex flex-col gap-4">
          <span class="block text-xs font-bold text-slate-400 uppercase tracking-wider">Dimensione Caratteri</span>
          
          <div>
            <div class="flex justify-between text-xs text-slate-600 mb-1">
              <span>Titolo Studio</span>
              <span id="titleSizeVal">12px</span>
            </div>
            <input type="range" id="mapTitleFontSize" min="8" max="24" value="12" class="w-full h-1.5 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-emerald-600">
          </div>

          <div>
            <div class="flex justify-between text-xs text-slate-600 mb-1">
              <span>Sottotitolo</span>
              <span id="subtitleSizeVal">10px</span>
            </div>
            <input type="range" id="mapSubtitleFontSize" min="6" max="20" value="10" class="w-full h-1.5 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-emerald-600">
          </div>
        </div>

        <div class="mt-auto border-t border-slate-100 pt-5 flex flex-col gap-3">
          <button id="exportMapPdfBtn" class="w-full py-3 px-4 bg-emerald-600 text-white font-bold rounded-xl hover:bg-emerald-700 transition-colors shadow-md flex items-center justify-center gap-2 text-sm">
            <i class="fas fa-file-pdf"></i> Esporta PDF (Singola Pagina)
          </button>
        </div>
      </div>

      <!-- Map Graphic Canvas (Right) -->
      <div class="flex-grow p-4 overflow-auto" style="background:#f8fafc;">
        <div id="studyMapCanvasOuter" class="w-full h-full" style="--map-title-size: 12px; --map-subtitle-size: 10px;">
          <!-- Content populated via JavaScript -->
        </div>
      </div>
    </div>

  </div>
</div>
